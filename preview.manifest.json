{
  "services": {
    "backend": {
      "cwd": ".",
      "cmd": "sh",
      "args": ["-c", "npx prisma migrate deploy && npx tsx src/server.ts"],
      "port": 8080,
      "healthCheck": {
        "path": "/health",
        "timeoutSeconds": 120
      }
    }
  },
  "routes": {
    "/": { "service": "backend", "stripPrefix": false }
  }
}
